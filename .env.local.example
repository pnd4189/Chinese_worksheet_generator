# Translation API Configuration

# MyMemory Translation API (DEFAULT - NO SETUP NEEDED!)
# ✅ Works immediately without any API key!
# ✅ Free 1000 translations/day (anonymous)
# ✅ Free 10000 translations/day with email
# To increase limit to 10k/day, add your email below (optional):
MYMEMORY_EMAIL=your_email@example.com

# Microsoft Translator API (Optional - for higher volume 500-1000 users)
# Get your free API key from: https://azure.microsoft.com/en-us/services/cognitive-services/translator/
AZURE_TRANSLATOR_KEY=your_azure_translator_key
AZURE_TRANSLATOR_REGION=eastus

# GLM-4-Flash API (Optional fallback)
# Get your free API key from: https://bigmodel.cn/usercenter/proj-mgmt/apikeys
GLM_API_KEY=your_glm_api_key

# Translation Provider Priority (comma-separated)
# Options: mymemory, microsoft_translator, glm_flash
# MyMemory is first because it works out of the box!
TRANSLATION_PROVIDERS=mymemory,microsoft_translator,glm_flash
